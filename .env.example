# ==============================================================================
# AIHubpedia Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual secure credentials.
# NEVER commit the actual .env file or production secrets to Git!
# ==============================================================================

# Application Environment
AIHUB_ENV=production
AIHUB_DEBUG=false
AIHUB_BASE_URL=https://aihubpedia.com
AIHUB_SITE_NAME=AIHubpedia

# Database Configuration (MySQL / MariaDB)
AIHUB_DB_HOST=localhost
AIHUB_DB_PORT=3306
AIHUB_DB_NAME=aihub
AIHUB_DB_USER=aihub_user
AIHUB_DB_PASS=your_strong_database_password_here

# Admin Dashboard Authentication
# Default username for admin login
AIHUB_ADMIN_USERNAME=admin
# Generate your bcrypt hash using: php -r "echo password_hash('YourSecretPassword', PASSWORD_BCRYPT);"
AIHUB_ADMIN_PASSWORD_HASH=$2y$10$exampleHashPlaceholderReplaceWithRealBcryptHash

# Session Security
# Generate a random 64-char string: php -r "echo bin2hex(random_bytes(32));"
AIHUB_SESSION_SECRET=your_random_64_character_session_secret_key_here

# Transactional Email / SMTP (PHPMailer)
AIHUB_MAIL_TO=contact@aihubpedia.com
AIHUB_MAIL_FROM=contact@aihubpedia.com
AIHUB_MAIL_FROM_NAME="AIHubpedia"
AIHUB_SMTP_HOST=smtp.gmail.com
AIHUB_SMTP_PORT=587
AIHUB_SMTP_SECURE=tls
AIHUB_SMTP_USER=your_smtp_user@example.com
AIHUB_SMTP_PASS=your_smtp_app_password_here
